{
  "name": "dsh-session-cost",
  "version": "0.2.1",
  "description": "DSH 会话费用统计：在输入框正下方的统计栏里加一颗费用胶囊，显示本对话累计费用与最近一轮费用，点开向上展开为「总命中/未命中费用 + 按轮明细」；金额按 token 事实在本地按当前价目表现算，可一键抓取官方价目页更新。 · A session-cost chip for DeepSeek Harness: this conversation's total and last-turn spend, an upward panel with cache-hit vs cache-miss totals and a per-turn breakdown, priced locally from token facts with a one-click official price-list refresh.",
  "license": "MIT",
  "author": "LanFeng97",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "cost",
    "token",
    "usage",
    "pricing",
    "plugin"
  ],
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LanFeng97/dsh-session-cost.git"
  },
  "homepage": "https://github.com/LanFeng97/dsh-session-cost#readme",
  "bugs": {
    "url": "https://github.com/LanFeng97/dsh-session-cost/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node tools/selftest.mjs",
    "test:live": "node tools/live-check.mjs",
    "test:schema": "node tools/schema-check.mjs",
    "install:local": "node tools/install.mjs"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "docs",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}

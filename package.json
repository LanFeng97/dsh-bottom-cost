{
  "name": "dsh-bottom-cost",
  "version": "0.3.0",
  "description": "Per-turn session cost chip in the composer stats row: each turn's spend, with the conversation total split into cache-hit and cache-miss (CNY), priced from an official price table that refreshes on demand. · 输入框下方统计栏里的会话费用胶囊：逐轮列出每轮花费，并把总额拆成缓存命中与未命中两笔（CNY）；价目表按需从官方定价页刷新。",
  "license": "MIT",
  "author": "LanFeng97",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "cost",
    "token",
    "usage",
    "pricing",
    "plugin"
  ],
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LanFeng97/dsh-bottom-cost.git"
  },
  "homepage": "https://github.com/LanFeng97/dsh-bottom-cost#readme",
  "bugs": {
    "url": "https://github.com/LanFeng97/dsh-bottom-cost/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node tools/selftest.mjs",
    "test:live": "node tools/live-check.mjs",
    "test:schema": "node tools/schema-check.mjs",
    "install:local": "node tools/install.mjs"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "docs",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
